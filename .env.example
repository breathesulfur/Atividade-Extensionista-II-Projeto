# Template das variáveis de ambiente do InclusivChat
# ---------------------------------------------------------------------------
# Copie este arquivo para:
#  • .env.development.local  → quando rodar `npm run dev` localmente (deve
#    apontar para o projeto Supabase de STAGING / homologação)
#  • .env.production         → build de produção (Vercel já injeta via UI;
#    geralmente não precisa ficar no repo)
#
# NUNCA versione o .env, .env.development.local ou .env.production —
# o .gitignore já cobre essas variantes.
# ---------------------------------------------------------------------------

# URL do projeto Supabase
# Para staging: usar URL do projeto inclusivchat-staging (criado separadamente)
# Para prod:    usar URL do projeto inclusivchat-prod
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Chave anônima (anon public) — encontrada em Supabase Dashboard
# Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY_HERE
